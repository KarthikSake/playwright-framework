{
  "name": "playwright-framework",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test framework for Automation Exercise (API, UI, and hybrid flows)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:flows": "playwright test tests/flows",
    "test:headed": "playwright test --headed",
    "test:serial": "playwright test --workers=1",
    "test:debug": "playwright test --workers=1 --headed --debug",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.7.2"
  }
}
